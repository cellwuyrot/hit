generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Category {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  icon            String        @default("")
  order           Int           @default(0)
  metaTitle       String        @default("")
  metaDescription String        @default("")
  seoText         String        @default("")
  parentId        String?
  parent          Category?     @relation("CategoryChildren", fields: [parentId], references: [id])
  children        Category[]    @relation("CategoryChildren")
  products        Product[]
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String         @default("")
  price       Float          @default(0)
  oldPrice    Float?
  image       String         @default("")
  image2      String         @default("")
  image3      String         @default("")
  image4      String         @default("")
  inStock     Int            @default(0)
  brand       String         @default("")
  color       String         @default("")
  productType String         @default("")
  country     String         @default("")
  barcode     String         @default("")
  code        String         @default("")
  weight      Float?
  volume      Float?
  packSize    Int?
  isFeatured  Boolean        @default(false)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SliderImage {
  id       String  @id @default(uuid())
  title    String  @default("")
  subtitle String  @default("")
  imageUrl String
  link     String  @default("")
  order    Int     @default(0)
  active   Boolean @default(true)
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("")
  lastName  String   @default("")
  phone     String   @default("")
  address   String   @default("")
  cart      CartItem[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([userId, productId])
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String      @default("new")
  total     Float
  name      String      @default("")
  phone     String      @default("")
  address   String      @default("")
  comment   String      @default("")
  items     OrderItem[]
  messages  Message[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
}

model News {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  content   String   @default("")
  image     String   @default("")
  type      String   @default("article")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SitePage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String   @default("")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  text      String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String   @default("user")
  text       String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  date      String
  createdAt DateTime @default(now())

  @@index([date])
  @@index([path])
}
